# --- المنطق البرمجي (Routes) ---
@app.route('/')
def index():
    q = request.args.get('q', '')
    if q:
        games = Game.query.filter(Game.title.contains(q) | Game.description.contains(q)).all()
    else:
        games = Game.query.order_by(Game.date_added.desc()).all()
    return render_template_string(MASTER_HTML, page='home', games=games, q=q)

@app.route('/login', methods=['GET', 'POST'])
def login():
    if request.method == 'POST':
        if request.form.get('password') == 'Brandy Renee':
            session['is_osama'] = True
            return redirect(url_for('upload'))
    return render_template_string(MASTER_HTML, page='login')

@app.route('/upload', methods=['GET', 'POST'])
def upload():
    if not session.get('is_osama'): return redirect(url_for('login'))
    if request.method == 'POST':
        new_game = Game(title=request.form['title'], description=request.form['desc'], 
                        image_url=request.form['img'], download_link=request.form['link'])
        db.session.add(new_game)
        db.session.commit()
        return redirect(url_for('index'))
    return render_template_string(MASTER_HTML, page='upload')

@app.route('/logout')
def logout():
    session.pop('is_osama', None)
    return redirect(url_for('index'))

if __name__ == '__main__':
    with app.app_context():
        db.create_all()
    # استخدام بورت السيرفر التلقائي
    port = int(os.environ.get("PORT", 5000))
    app.run(host='0.0.0.0', port=port)
